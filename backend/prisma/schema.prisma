generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector")]
}

model User {
  id            String   @id @default(uuid())
  nama          String
  email         String   @unique
  password      String
  role          Role     @default(MAHASISWA)
  instansi      String?
  pelatihan     String?
  jadwal        String?
  createdAt     DateTime @default(now())
  soal          Soal[]
  jadwalDosen   Pertemuan[] @relation("DosenPertemuan")
  jadwalAsisten Pertemuan[] @relation("AsistenPertemuan")
  mataKuliah    MataKuliah[] @relation("PengajarMataKuliah")
  pendaftaran   Pendaftaran[]
  submissions   Submission[]
  progress      StudentProgress[]
  ujianSubmissions UjianSubmission[]
}

model MataKuliah {
  id                String   @id @default(uuid())
  nama              String
  kode              String   @unique
  published         Boolean  @default(false)
  deskripsi         String?
  kapasitas         Int?
  kategori          String?
  level             String?  @default("Beginner")
  warna             String?  @default("blue")
  statusPendaftaran String?
  tipeKursus        TipeKursus?
  pengajarId        String?
  pengajar          User?    @relation("PengajarMataKuliah", fields: [pengajarId], references: [id])
  jumlahPertemuan   Int      @default(14)
  createdAt         DateTime @default(now())
  soal              Soal[]
  pertemuan         Pertemuan[]
  materi            Materi[]
  pendaftaran       Pendaftaran[]
  ujian             Ujian?

  // self-referencing many-to-many relationship
  prerequisites     MataKuliah[]  @relation("MataKuliahPrerequisites")
  prerequisiteFor   MataKuliah[]  @relation("MataKuliahPrerequisites")
}

model Pertemuan {
  id           String     @id @default(uuid())
  mataKuliahId String
  mataKuliah   MataKuliah @relation(fields: [mataKuliahId], references: [id])
  urutan       Int        // 1-14
  topik        String?
  tgl          DateTime?
  jam          String?
  dosenId      String?
  dosen        User?      @relation("DosenPertemuan", fields: [dosenId], references: [id])
  asistenId    String?
  asisten      User?      @relation("AsistenPertemuan", fields: [asistenId], references: [id])
  materi       Materi[]
  soal         Soal[]
  submissions  Submission[]
  progress     StudentProgress[]
  createdAt    DateTime   @default(now())
}

model Materi {
  id              String          @id @default(uuid())
  nama            String
  pertemuanId     String
  pertemuan       Pertemuan       @relation(fields: [pertemuanId], references: [id])
  mataKuliahId    String
  mataKuliah      MataKuliah      @relation(fields: [mataKuliahId], references: [id])
  fileUrl         String?
  videoUrl        String?
  refleksi        String?
  embeddingStatus EmbeddingStatus @default(WAITING)
  createdAt       DateTime        @default(now())
}

model Sertifikat {
  id           String     @id @default(uuid())
  userId       String
  mataKuliahId String
  nilai        Float
  noSertifikat String     @unique
  fileUrl      String?
  createdAt    DateTime   @default(now())
}

model Soal {
  id           String     @id @default(uuid())
  pertanyaan   String
  tipesoal     TipeSoal
  status       SoalStatus @default(APPROVED)
  mataKuliahId String
  mataKuliah   MataKuliah @relation(fields: [mataKuliahId], references: [id])
  pertemuanId  String?
  pertemuan    Pertemuan? @relation(fields: [pertemuanId], references: [id])
  dibuatOleh   String
  pembuat      User       @relation(fields: [dibuatOleh], references: [id])
  createdAt    DateTime   @default(now())
  evaluasi     Evaluasi[]
  vector       SoalVector?
}

model Evaluasi {
  id           String   @id @default(uuid())
  soalId       String
  soal         Soal     @relation(fields: [soalId], references: [id])
  skorKualitas Float
  tingkatKesulitan String
  isDuplikat   Boolean  @default(false)
  saranPerbaikan String?
  createdAt    DateTime @default(now())
}

enum Role {
  MAHASISWA
  DOSEN
  ASISTEN
  ADMIN
}

enum TipeSoal {
  PILIHAN_GANDA
  ESSAY
  BENAR_SALAH
}

enum TipeKursus {
  ONLINE
  OFFLINE
  HYBRID
}

enum SoalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmbeddingStatus {
  WAITING
  PROCESSING
  SUCCESS
  FAILED
}

model SoalVector {
  id           String                      @id @default(uuid())
  soalId       String                      @unique
  soal         Soal                        @relation(fields: [soalId], references: [id])
  mataKuliahId String
  content      String
  embedding    Unsupported("vector(768)")
  metadata     Json?
  createdAt    DateTime                    @default(now())
}

model Pendaftaran {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  mataKuliahId String
  mataKuliah   MataKuliah @relation(fields: [mataKuliahId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([userId, mataKuliahId])
}

model Submission {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  pertemuanId  String
  pertemuan    Pertemuan  @relation(fields: [pertemuanId], references: [id])
  type         String     // "REFLEKSI", "FILE_UPLOAD", "SCREENSHOT"
  content      String?    // Teks jawaban refleksi
  fileUrl      String?    // URL file yang diupload (ZIP/Screenshot)
  score        Float?     // Nilai final dari asisten/pengajar (0-100)
  aiScore      Float?     // Skor referensi otomatis dari AI (0-100)
  feedback     String?    // Catatan koreksi dari asisten/pengajar
  createdAt    DateTime   @default(now())

  @@unique([userId, pertemuanId, type])
}

model StudentProgress {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  pertemuanId  String
  pertemuan    Pertemuan  @relation(fields: [pertemuanId], references: [id])
  watchedTime  Int        @default(0)     // Persentase video ditonton (0-100)
  isCompleted  Boolean    @default(false) // Status "Selesai" pada pertemuan
  updatedAt    DateTime   @updatedAt
  createdAt    DateTime   @default(now())

  @@unique([userId, pertemuanId])
}

model Ujian {
  id           String            @id @default(uuid())
  mataKuliahId String            @unique
  mataKuliah   MataKuliah        @relation(fields: [mataKuliahId], references: [id])
  durasi       Int               @default(90)
  submissions  UjianSubmission[]
  createdAt    DateTime          @default(now())
}

model UjianSubmission {
  id        String   @id @default(uuid())
  ujianId   String
  ujian     Ujian    @relation(fields: [ujianId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  score     Float
  answers   Json
  feedback  String?
  createdAt DateTime @default(now())

  @@unique([userId, ujianId])
}
